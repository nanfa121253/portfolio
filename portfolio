<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Nanfah — Creative Portfolio</title>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

:root{
    --bg:#080b09;
    --card:#101612;
    --card2:#141b16;
    --green:#39d98a;
    --green-dark:#123d2b;
    --gold:#d7b86a;
    --white:#f4f5f2;
    --muted:#8c9690;
    --border:rgba(255,255,255,.09);
}

body{
    background:
        radial-gradient(circle at 80% 10%,rgba(57,217,138,.10),transparent 28%),
        radial-gradient(circle at 10% 80%,rgba(215,184,106,.07),transparent 25%),
        var(--bg);
    color:var(--white);
    font-family:'Plus Jakarta Sans',sans-serif;
    overflow-x:hidden;
}

a{
    text-decoration:none;
    color:inherit;
}

.container{
    width:min(1180px,92%);
    margin:auto;
}

/* NAVBAR */

nav{
    position:fixed;
    top:20px;
    left:50%;
    transform:translateX(-50%);
    width:min(1100px,92%);
    z-index:100;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:14px 20px;
    border:1px solid var(--border);
    border-radius:18px;
    background:rgba(10,14,11,.78);
    backdrop-filter:blur(18px);
}

.logo{
    font-family:'Instrument Serif',serif;
    font-size:27px;
    font-style:italic;
}

.logo span{
    color:var(--green);
}

.nav-links{
    display:flex;
    gap:6px;
}

.nav-links a{
    padding:9px 14px;
    border-radius:10px;
    color:#aeb5b0;
    font-size:13px;
    transition:.3s;
}

.nav-links a:hover{
    color:white;
    background:#1b251e;
}

.nav-btn{
    padding:10px 17px;
    border-radius:10px;
    background:var(--green);
    color:#07120c;
    font-weight:700;
    font-size:13px;
}

/* HERO */

.hero{
    min-height:100vh;
    display:grid;
    grid-template-columns:1.15fr .85fr;
    align-items:center;
    gap:70px;
    padding-top:100px;
}

.eyebrow{
    color:var(--green);
    font-size:12px;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:20px;
}

.hero h1{
    font-family:'Instrument Serif',serif;
    font-size:clamp(70px,9vw,125px);
    font-weight:400;
    line-height:.82;
    letter-spacing:-4px;
}

.hero h1 span{
    color:var(--gold);
    font-style:italic;
}

.hero-text{
    max-width:580px;
    margin-top:30px;
    color:var(--muted);
    font-size:16px;
    line-height:1.9;
}

.hero-buttons{
    display:flex;
    gap:12px;
    margin-top:35px;
}

.primary{
    background:var(--green);
    color:#07120c;
    padding:14px 22px;
    border-radius:11px;
    font-weight:700;
    transition:.3s;
}

.primary:hover{
    transform:translateY(-3px);
    box-shadow:0 15px 35px rgba(57,217,138,.2);
}

.secondary{
    border:1px solid var(--border);
    padding:14px 22px;
    border-radius:11px;
    color:#c5cbc7;
}

.secondary:hover{
    border-color:var(--green);
}

/* PROFILE */

.profile-wrap{
    position:relative;
    display:flex;
    justify-content:center;
}

.profile-ring{
    width:390px;
    height:480px;
    border:1px solid rgba(57,217,138,.35);
    border-radius:200px 200px 25px 25px;
    padding:12px;
    transform:rotate(3deg);
}

.profile{
    width:100%;
    height:100%;
    object-fit:cover;
    border-radius:190px 190px 18px 18px;
    transform:rotate(-3deg);
    filter:saturate(.9);
}

.profile-label{
    position:absolute;
    bottom:30px;
    left:-30px;
    background:#111812;
    border:1px solid var(--border);
    padding:14px 18px;
    border-radius:13px;
    transform:rotate(-4deg);
}

.profile-label strong{
    display:block;
    color:var(--green);
    font-size:12px;
}

.profile-label small{
    color:#8d968f;
}

/* SECTION */

.section{
    padding:110px 0;
}

.section-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    margin-bottom:45px;
}

.section-number{
    color:var(--green);
    font-size:12px;
    letter-spacing:2px;
}

.section-title{
    font-family:'Instrument Serif',serif;
    font-size:58px;
    font-weight:400;
}

.section-desc{
    max-width:420px;
    color:var(--muted);
    line-height:1.8;
    font-size:14px;
}

/* ABOUT */

.about-grid{
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:20px;
}

.about-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:24px;
    padding:35px;
}

.about-card h3{
    font-family:'Instrument Serif',serif;
    font-size:38px;
    margin-bottom:20px;
}

.about-card p{
    color:var(--muted);
    line-height:1.9;
    font-size:14px;
}

.quote{
    margin-top:30px;
    padding-left:20px;
    border-left:2px solid var(--gold);
    color:#c8cec9!important;
    font-style:italic;
}

/* SKILLS */

.skills{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.skill{
    padding:27px;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:18px;
    transition:.35s;
}

.skill:hover{
    transform:translateY(-7px);
    border-color:rgba(57,217,138,.35);
}

.skill-icon{
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:10px;
    background:var(--green-dark);
    color:var(--green);
    margin-bottom:20px;
    font-weight:800;
}

.skill h4{
    margin-bottom:8px;
}

.skill p{
    color:var(--muted);
    font-size:13px;
    line-height:1.7;
}

/* PROJECTS */

.projects{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

.project{
    min-height:300px;
    padding:30px;
    border-radius:22px;
    background:linear-gradient(145deg,#151c17,#0d120e);
    border:1px solid var(--border);
    position:relative;
    overflow:hidden;
    transition:.35s;
}

.project:hover{
    transform:translateY(-6px);
}

.project:nth-child(2){
    background:linear-gradient(145deg,#19170f,#0d0e0b);
}

.project:nth-child(3){
    background:linear-gradient(145deg,#101a17,#0b100e);
}

.project-number{
    color:var(--green);
    font-size:12px;
}

.project h3{
    font-family:'Instrument Serif',serif;
    font-size:43px;
    font-weight:400;
    margin-top:65px;
}

.project p{
    color:var(--muted);
    font-size:13px;
    max-width:450px;
    margin-top:12px;
}

.project-link{
    position:absolute;
    right:25px;
    bottom:25px;
    width:42px;
    height:42px;
    border:1px solid var(--border);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--gold);
}

/* EXPERIENCE */

.timeline{
    border-left:1px solid #28342d;
    margin-left:15px;
}

.timeline-item{
    position:relative;
    padding:0 0 55px 40px;
}

.timeline-item::before{
    content:'';
    position:absolute;
    left:-5px;
    top:5px;
    width:9px;
    height:9px;
    background:var(--green);
    border-radius:50%;
    box-shadow:0 0 20px rgba(57,217,138,.6);
}

.timeline-year{
    color:var(--gold);
    font-size:12px;
    margin-bottom:10px;
}

.timeline-item h3{
    font-family:'Instrument Serif',serif;
    font-size:32px;
    font-weight:400;
}

.timeline-item p{
    color:var(--muted);
    margin-top:8px;
    line-height:1.8;
    font-size:14px;
}

/* CONTACT */

.contact{
    padding:70px;
    background:linear-gradient(135deg,#132019,#0e130f);
    border:1px solid var(--border);
    border-radius:28px;
    text-align:center;
}

.contact h2{
    font-family:'Instrument Serif',serif;
    font-size:65px;
    font-weight:400;
}

.contact h2 span{
    color:var(--green);
    font-style:italic;
}

.contact p{
    color:var(--muted);
    margin:15px auto 30px;
    max-width:500px;
    line-height:1.8;
}

footer{
    text-align:center;
    padding:50px 0;
    color:#68716b;
    font-size:12px;
}

/* MOBILE */

@media(max-width:800px){

    .nav-links{
        display:none;
    }

    .hero{
        grid-template-columns:1fr;
        gap:45px;
        padding-top:140px;
    }

    .hero h1{
        font-size:75px;
    }

    .profile-wrap{
        order:-1;
    }

    .profile-ring{
        width:280px;
        height:350px;
    }

    .profile-label{
        left:5%;
    }

    .about-grid{
        grid-template-columns:1fr;
    }

    .skills{
        grid-template-columns:1fr;
    }

    .projects{
        grid-template-columns:1fr;
    }

    .section-head{
        display:block;
    }

    .section-desc{
        margin-top:15px;
    }

    .contact{
        padding:45px 20px;
    }

    .contact h2{
        font-size:48px;
    }
}
</style>
</head>

